# Configuração do Firebase (Console > Configurações do projeto > Seus apps > app Web).
# Estes valores não são secretos: identificam o projeto. Quem protege os dados
# são as regras do Firestore (firestore.rules) e a exigência de e-mail verificado.
# Para rodar: copie este arquivo para ".env" (cp .env.example .env).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCI8PZdG6vQbklp-wtWLKzBsVyuBPRXZZ4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=carona-campus-84abe.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=carona-campus-84abe
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=carona-campus-84abe.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=16651932522
EXPO_PUBLIC_FIREBASE_APP_ID=1:16651932522:web:980d884a2b20b89f064b13

# Modelo do Gemini usado na publicação de viagens.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Chave da Gemini API (Google AI Studio > Get API key, projeto carona-campus-84abe).
# ESTA É SECRETA: preencha só no seu .env, nunca neste arquivo nem no GitHub.
